<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.EventManager.TypeLabel" parent="">
        <item name="android:background">@drawable/bg_type_label</item>
        <item name="android:paddingStart">@dimen/type_label_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/type_label_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/type_label_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/type_label_padding_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Medium flexible app bar from the Material 1.14 tokens; Large is deprecated. -->
    <style name="Widget.EventManager.CollapsingToolbar"
        parent="Widget.Material3.CollapsingToolbar.Medium">
        <item name="collapsedSubtitleTextAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="collapsedSubtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="expandedSubtitleTextAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="expandedSubtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <!-- Below the toolbar row, so the title stays put with or without a subtitle. -->
        <item name="expandedTitleGravity">top|start</item>
        <item name="expandedTitleMarginTop">?attr/actionBarSize</item>
        <item name="expandedTitleSpacing">@dimen/app_bar_title_spacing</item>
        <item name="expandedTitleTextAppearance">?attr/textAppearanceHeadlineMedium</item>
    </style>

    <!-- Small extended FAB tokens, colored as in the Material FAB theming guide. -->
    <style name="Widget.EventManager.AddButton"
        parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <!-- The plus sign is inset 5dp in its icon, so 12dp matches the 16dp end visually. -->
        <item name="android:paddingStart">@dimen/space_medium</item>
        <item name="android:paddingEnd">@dimen/screen_padding</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="iconPadding">@dimen/space_small</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.EventManager.AddButton</item>
    </style>

    <style name="ThemeOverlay.EventManager.AddButton" parent="">
        <item name="colorContainer">?attr/colorPrimary</item>
        <item name="colorOnContainer">?attr/colorOnPrimary</item>
    </style>

    <!-- Confirming buttons that lose data, such as Discard, are red. -->
    <style name="ThemeOverlay.EventManager.DestructiveDialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.EventManager.DestructiveButton</item>
    </style>

    <style name="Widget.EventManager.DestructiveButton"
        parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="materialThemeOverlay">@style/ThemeOverlay.EventManager.DestructiveButton</item>
    </style>

    <style name="ThemeOverlay.EventManager.DestructiveButton"
        parent="ThemeOverlay.Material3.Button.TextButton">
        <item name="colorOnContainer">?attr/colorError</item>
    </style>

    <!-- The platform date picker takes its accents from attributes Material sets to secondary. -->
    <style name="ThemeOverlay.EventManager.Picker" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
    </style>

    <!-- Each field keeps a line for its message, so an error does not move the form. -->
    <style name="Widget.EventManager.TextField"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="errorEnabled">true</item>
        <item name="errorIconDrawable">@drawable/ic_error_outline</item>
    </style>

    <style name="Widget.EventManager.DropdownField"
        parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="errorEnabled">true</item>
    </style>

    <!-- Medium square button tokens, matching the fields and the Add event button. -->
    <style name="Widget.EventManager.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerLarge</item>
    </style>

    <style name="Widget.EventManager.MonthHeading" parent="">
        <item name="android:accessibilityHeading">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:paddingStart">@dimen/card_margin</item>
        <item name="android:paddingEnd">@dimen/card_margin</item>
        <item name="android:paddingTop">@dimen/screen_padding</item>
        <item name="android:paddingBottom">@dimen/card_margin</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.EventManager.TicketStub" parent="">
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="Widget.EventManager.TicketStub.Month">
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <style name="Widget.EventManager.TicketStub.Day">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
    </style>

    <style name="Widget.EventManager.TicketStub.DayOfWeek">
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
    </style>

    <style name="Widget.EventManager.TicketTime" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.EventManager.TicketTimeLine" parent="">
        <item name="android:background">?attr/colorOutlineVariant</item>
        <item name="android:layout_marginStart">@dimen/space_small</item>
        <item name="android:layout_marginEnd">@dimen/space_small</item>
    </style>

    <style name="Widget.EventManager.EventDetail" parent="">
        <item name="android:drawablePadding">@dimen/space_small</item>
        <item name="android:drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Event details screen -->
    <style name="Widget.EventManager.DetailLabel" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.EventManager.DetailTime" parent="">
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.EventManager.DetailDate" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.EventManager.DetailValue" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
